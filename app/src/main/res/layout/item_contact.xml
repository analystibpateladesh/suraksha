<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingVertical="10dp">

    <TextView android:id="@+id/contactAvatar"
        android:layout_width="38dp" android:layout_height="38dp"
        android:background="#1a1a2e" android:textColor="#818cf8"
        android:gravity="center" android:textSize="13sp" android:textStyle="bold"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/contactName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="#e0e0e0"/>
        <TextView android:id="@+id/contactPhone"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#555"/>
    </LinearLayout>

    <Button android:id="@+id/removeBtn"
        android:layout_width="32dp" android:layout_height="32dp"
        android:text="✕" android:textSize="14sp" android:textColor="#666"
        android:backgroundTint="#1a1a1a" android:padding="0dp"/>
</LinearLayout>